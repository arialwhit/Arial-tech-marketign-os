# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# For Vercel hosting, set this in `.env` and run `npm run vercel:env` (or `npm run vercel:deploy`).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The public URL where this app is hosted (e.g. https://arial-tech-marketing-os.vercel.app).
APP_URL="MY_APP_URL"

# Optional External Marketing & Billing Provider Credentials
COMPOSIO_API_KEY=""
COMPOSIO_MCP_URL="https://connect.composio.dev/mcp"
META_APP_ID=""
META_APP_SECRET=""
TIKTOK_CLIENT_KEY=""
TIKTOK_CLIENT_SECRET=""
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""
STRIPE_SECRET_KEY=""
PAYSTACK_SECRET_KEY=""

# Server-Side AES-256-GCM Secret for Analytics Provider Credentials (recommended for Vercel serverless)
MOS_CREDENTIAL_SECRET=""

# Optional Cron Secret for authenticating POST/GET /api/cron/tick on Vercel
CRON_SECRET=""

# Optional Explicit Binary Paths for Video Render Workers (local / Docker)
# FFMPEG_PATH=""
# FFPROBE_PATH=""

# Optional Automated Vercel Deployment & Env-Sync Credentials (used by `npm run vercel:deploy` / GitHub Actions)
# VERCEL_TOKEN=""
# VERCEL_PROJECT_ID=""
# VERCEL_ORG_ID=""

